# ---------------------------------------------------------------------------
# CodeGuard AI 环境变量模板
# 用法：复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，不会被提交。
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
# ---------------------------------------------------------------------------

# ============================ 1. 服务运行参数 ============================
# 监听端口
PORT=8848
# 监听地址：127.0.0.1 仅本机可访问；0.0.0.0 允许局域网访问（演示时使用）
HOST=127.0.0.1
# 运行环境：development | production | test
NODE_ENV=development
# 日志级别：debug | info | warn | error
LOG_LEVEL=info
# 日志格式：pretty（带颜色，适合本地）| json（适合容器与日志采集）
LOG_FORMAT=pretty
# 单次请求体上限（字节），默认 5MB
MAX_BODY_BYTES=5242880

# ============================ 2. 大模型服务配置 ============================
# 供应商：deepseek | openai-compatible | mock
#   deepseek           —— 使用 DeepSeek 官方接口
#   openai-compatible  —— 任意兼容 OpenAI /chat/completions 协议的服务
#                          （如 Moonshot Kimi、火山方舟、通义、本地 Ollama / vLLM）
#   mock               —— 离线确定性模拟器，无需密钥即可跑通全流程（用于单元测试与断网演示）
LLM_PROVIDER=deepseek

# --- DeepSeek 官方 ---
# 申请地址：https://platform.deepseek.com/api_keys
# 可用模型可用 `GET /models` 查询，本项目实测可用值：deepseek-flash、deepseek-v4-pro
# 若你的账号已开放 deepseek-chat / deepseek-reasoner，也可直接替换为对应名称
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- 通用 OpenAI 兼容后端（LLM_PROVIDER=openai-compatible 时生效）---
# 示例（Moonshot Kimi）: https://api.moonshot.cn/v1
# 示例（火山方舟）     : https://ark.cn-beijing.volces.com/api/v3
# 示例（本地 Ollama）  : http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# ============================ 3. 审查引擎参数 ============================
# 是否启用大模型审查（false 时仅运行本地规则引擎，完全离线）
REVIEW_ENABLE_LLM=true
# 大模型采样温度，代码审查建议 0 ~ 0.3 以保证结论稳定
REVIEW_TEMPERATURE=0.2
# 单次大模型调用最大输出 token
# 注意：DeepSeek-V4-Flash 等含思维链的模型会把推理过程计入输出预算，
#       该值过小会导致正文被截断（表现为 JSON 解析失败），建议不低于 16000
REVIEW_MAX_TOKENS=16000
# 大模型审查并发度（同时发起多少个角色请求）
REVIEW_CONCURRENCY=2
# 单次大模型请求超时（毫秒）
REVIEW_TIMEOUT_MS=120000
# 超时/网络失败后的重试次数
REVIEW_MAX_RETRIES=2
# 送审代码最大行数，超出则自动分段审查
REVIEW_MAX_LINES=1200
# 每段送审代码行数
REVIEW_CHUNK_LINES=400

# ============================ 4. 存储与产物 ============================
# 评审记录存放目录（相对于项目根）
DATA_DIR=data
# 是否保留每次评审的原始报告文件
KEEP_REPORT_FILES=true

# ============================ 5. Gitee 集成（可选） ============================
# 用于「提交仓库地址自动审查」功能；留空则关闭该能力
# 生成地址：Gitee → 设置 → 私人令牌，勾选 projects 只读权限
GITEE_ACCESS_TOKEN=
GITEE_API_BASE=https://gitee.com/api/v5
