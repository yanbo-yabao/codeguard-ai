          "rules": [
            {
              "id": "SEC001",
              "name": "SEC001",
              "shortDescription": {
                "text": "硬编码敏感凭据"
              },
              "fullDescription": {
                "text": "改用环境变量或密钥管理服务注入。Node 项目读取 process.env.XXX，Python 项目读取 os.environ[\"XXX\"]，并在 .env.example 中只保留占位符。若凭据曾进入版本库，必须立即在服务端轮换。"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "dimension": "security",
                "severity": "blocker",
                "source": "static"
              }
            },
            {
              "id": "SEC003",
              "name": "SEC003",
              "shortDescription": {
                "text": "SQL 语句拼接（注入风险）"
              },
              "fullDescription": {
                "text": "统一改用参数化查询：Node 用 db.query(\"... WHERE id = ?\", [id])，Python 用 cursor.execute(\"... WHERE id = %s\", (id,))，Java 用 PreparedStatement。动态表名/列名需用白名单映射校验。"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "dimension": "security",
                "severity": "blocker",
                "source": "static"
              }
            },
            {
              "id": "SEC007",
              "name": "SEC007",
              "shortDescription": {
                "text": "关闭 TLS 证书校验"
              },
              "fullDescription": {
                "text": "恢复证书校验，并通过 NODE_EXTRA_CA_CERTS 或 CA_BUNDLE 指向企业自签根证书来解决信任链问题；禁止在源码中硬编码 verify=False。"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "dimension": "security",
                "severity": "critical",
                "source": "static"
              }
            },
            {
              "id": "LLM-BUG",
              "name": "LLM-BUG",
              "shortDescription": {
                "text": "db 未声明导致必然抛错"
              },
              "fullDescription": {
                "text": "引入或注入 db 实例，例如 const db = require('./db')；若 db 由外部注入，应显式声明参数并校验。"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "dimension": "bug",
                "severity": "critical",
                "source": "llm"
              }
            },
            {
              "id": "SEC005",
              "name": "SEC005",
              "shortDescription": {
                "text": "使用非密码学安全随机数生成凭据"
              },
              "fullDescription": {
                "text": "Node 使用 crypto.randomUUID() 或 crypto.randomBytes(32).toString(\"hex\")；Python 使用 secrets.token_urlsafe(32)；Java 使用 SecureRandom；Go 使用 crypto/rand。"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "dimension": "security",
                "severity": "critical",
                "source": "static"
              }
            },
            {
              "id": "LLM-SEC",
              "name": "LLM-SEC",
              "shortDescription": {
                "text": "导出不安全 Agent 全局复用"
              },
              "fullDescription": {
                "text": "删除该导出；确需访问自签服务时，为特定目标创建携带受信 CA 的 Agent（new https.Agent({ ca: fs.readFileSync('internal-ca.pem') })），保持 rejectUnauthorized 为默认 true，并禁止在模块级别生成全局共享 Agent。"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "dimension": "security",
                "severity": "critical",
                "source": "llm"
              }
            },
            {
              "id": "LLM-REA",
              "name": "LLM-REA",
              "shortDescription": {
                "text": "隐式全局依赖未声明"
              },
              "fullDescription": {
                "text": "显式声明依赖：文件顶部 `const db = require('./db');` 与 `const { fetchRemote } = require('./remote');`，或改为依赖注入 `function findUserByName(db, name)`，便于测试时传入 stub。"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "dimension": "maintainability",
                "severity": "major",
                "source": "llm"
              }
            },
            {
              "id": "BUG002",
              "name": "BUG002",
              "shortDescription": {
                "text": "异常被静默吞掉"
              },
              "fullDescription": {
                "text": "在 catch 中至少执行三件事之一：向上抛出、记录带上下文的错误日志、返回明确的可观察降级结果。禁止出现空的 catch 块。"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "dimension": "bug",
                "severity": "major",
                "source": "static"
              }
            },
            {
              "id": "BUG005",
              "name": "BUG005",
              "shortDescription": {
                "text": "除法运算缺少零值保护"
              },
              "fullDescription": {
                "text": "在除法前显式判断除数：if (denominator === 0) return 0; 或使用安全除法工具函数统一兜底。"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "dimension": "bug",
                "severity": "major",
                "source": "static"
              }
            },
            {
              "id": "BUG001",
              "name": "BUG001",
              "shortDescription": {
                "text": "使用松散相等比较"
              },
              "fullDescription": {
                "text": "统一使用 === / !== 做严格比较；确需宽松比较时显式写出转换逻辑（如 Number(x) === 0）。"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "dimension": "bug",
                "severity": "major",
                "source": "static"
              }
            },
            {
              "id": "PERF002",
              "name": "PERF002",
              "shortDescription": {
                "text": "循环内执行同步阻塞 IO"
              },
              "fullDescription": {
                "text": "改用异步版本（fs.promises.readFile / util.promisify 后的函数）；确需同步的场景应放到 worker_threads 或独立进程中执行。"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "dimension": "performance",
                "severity": "major",
                "source": "static"
              }
            },
            {
              "id": "PERF001",
              "name": "PERF001",
              "shortDescription": {
                "text": "循环内使用 await 串行等待"
              },
              "fullDescription": {
                "text": "无依赖关系时改用 Promise.all(items.map(async (item) => ...)) 并行执行；需要限制并发度时使用 p-limit（或自研信号量）控制在 5~10 之间。"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "dimension": "performance",
                "severity": "major",
                "source": "static"
              }
            },
            {
              "id": "SEC008",
              "name": "SEC008",
              "shortDescription": {
                "text": "使用已被攻破的哈希算法"
              },
              "fullDescription": {
                "text": "口令存储使用 bcrypt / scrypt / Argon2 并加盐；完整性校验使用 SHA-256 及以上；需要防篡改且要求密钥时使用 HMAC-SHA256。"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "dimension": "security",
                "severity": "major",
                "source": "static"
              }
            },
            {
              "id": "LLM-PER",
              "name": "LLM-PER",
              "shortDescription": {
                "text": "SELECT * 读取冗余列"
              },
              "fullDescription": {
                "text": "显式列出调用方真正需要的列，例如 SELECT id, name, email FROM users WHERE name = ?；若 name 唯一，可加 LIMIT 1。"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "dimension": "performance",
                "severity": "minor",
                "source": "llm"
              }
            },
            {
              "id": "STY002",
              "name": "STY002",
              "shortDescription": {
                "text": "调试输出残留"
              },
              "fullDescription": {
                "text": "改用统一日志组件并按级别输出（logger.debug/info/warn/error）；提交前通过 lint 规则禁止裸 console 调用。"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "dimension": "readability",
                "severity": "minor",
                "source": "static"
              }
            }
          ]
        }
