{
  "name": "codeguard-ai",
  "version": "2.0.0",
  "description": "CodeGuard AI（智码审）—— AI 编程学习助手：提问/拍题得讲解与代码，变式练习在线判题，逐行调试定位问题",
  "keywords": [
    "ai",
    "code-review",
    "static-analysis",
    "llm",
    "agent",
    "deepseek",
    "gitee"
  ],
  "license": "MIT",
  "type": "commonjs",
  "main": "src/server.js",
  "bin": {
    "codeguard": "bin/codeguard.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "mcp": "node bin/codeguard.js mcp",
    "complete": "node bin/codeguard.js complete",
    "fix": "node bin/codeguard.js fix",
    "quiz": "node bin/codeguard.js quiz",
    "run": "node bin/codeguard.js run",
    "doctor": "node bin/codeguard.js doctor",
    "rules": "node bin/codeguard.js rules",
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\""
  },
  "dependencies": {},
  "devDependencies": {},
  "files": [
    "bin",
    "src",
    "web",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ]
}
